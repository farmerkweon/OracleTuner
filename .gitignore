# ── 절대 커밋하면 안 되는 것 ──────────────────────────────────────────────
# 접속정보(암호화되어 있어도 개인 환경 정보), 복호화 키
config/
!config/.gitkeep

# 사용자 데이터 — 저장한 SQL, 튜닝 이력
data/
!data/.gitkeep

# 실행 로그
logs/
!logs/.gitkeep

# ── 빌드 산출물 ───────────────────────────────────────────────────────────
node_modules/
java/out/
dist/

# Oracle JDBC 드라이버 — Oracle 라이선스(FUTC) 대상이라 재배포하지 않는다.
# 사용자가 `npm run fetch-driver` 로 직접 받는다.
java/lib/*.jar

# ── 편집기·OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# PlantUML(MIT 변종) jar — Maven Central 에서 받는다(design/fetch-plantuml.js).
# 렌더 결과 SVG(web/design/*.svg)는 커밋 대상이지만 jar 자체는 배포물·git 에 넣지 않는다.
design/vendor/

# ── 도구 상태 ─────────────────────────────────────────────────────────────
.omc/
*.log
